# Binance Web3 API (server only, never NEXT_PUBLIC_)
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
BINANCE_WEB3_BASE_URL=https://web3.binance.com/build

# BSC
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_RPC_URL_FALLBACK=https://bsc-dataseed1.defibit.io

# Database (Postgres, Frankfurt)
DATABASE_URL=postgres://user:pass@host:5432/ijaro

# House wallet (server only; total balance <= $300)
HOUSE_WALLET_PRIVATE_KEY=

# Execution
EXECUTION_MODE=simulate            # simulate | live
HOUSE_MAX_PER_TX_USD=25
SANDBOX_MAX_PER_PLAN_USD=5
DAILY_SPEND_CAP_USD=50
MIN_BUY_USD=2
MAX_PRINCIPAL_USD=1000

# Judge Mode
JUDGE_CODES=

# Ops alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=

# Telemetry
REGION_TAG=kr-dev                   # kr-dev | fra | icn
NEXT_PUBLIC_APP_URL=http://localhost:3000
