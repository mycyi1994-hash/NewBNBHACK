{
  "name": "yieldvest",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @yieldvest/web --filter @yieldvest/agent dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0 && prettier --check . && tsx apps/web/scripts/copy.ts lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "fetch-docs": "bash scripts/fetch-docs.sh",
    "endpoints": "tsx scripts/gen-endpoints.ts",
    "reach": "tsx scripts/reach.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:rollback": "tsx scripts/db-rollback.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "dx:metrics": "tsx scripts/dx-metrics.ts",
    "dx:events": "tsx scripts/dx-events.ts",
    "alert:test": "tsx scripts/alert-test.ts",
    "db:count": "tsx scripts/db-count.ts",
    "tape:once": "tsx scripts/tape-once.ts",
    "cycle:once": "tsx scripts/cycle-once.ts",
    "yield:deposit": "tsx scripts/yield-deposit.ts",
    "yield:redeem": "tsx scripts/yield-redeem.ts",
    "plan:status": "tsx scripts/plan-status.ts",
    "plan:set": "tsx scripts/plan-set.ts",
    "smoke": "tsx scripts/smoke.ts",
    "live:check": "tsx scripts/live-check.ts",
    "registry": "tsx scripts/registry.ts",
    "spike:quotes": "tsx scripts/spike-quotes.ts",
    "spike:venus": "tsx scripts/spike-venus.ts",
    "coverage:core": "vitest run --project @yieldvest/core --coverage",
    "copy:gen": "tsx apps/web/scripts/copy.ts gen",
    "lint:copy": "tsx apps/web/scripts/copy.ts lint",
    "ui:check": "tsx scripts/ui-check.ts",
    "qa:check": "tsx scripts/qa-check.ts",
    "receipts:table": "tsx scripts/receipts-table.ts",
    "lp:build": "pnpm --filter @yieldvest/rwa-lp build:contracts",
    "lp:test": "pnpm --filter @yieldvest/rwa-lp test:contracts",
    "lp:abi": "pnpm --filter @yieldvest/rwa-lp abi",
    "lp:vectors": "pnpm --filter @yieldvest/rwa-lp vectors",
    "lp:status": "tsx scripts/lp-status.ts",
    "lp:market": "tsx scripts/lp-market.ts",
    "baw:help": "tsx scripts/baw-help.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.6",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
