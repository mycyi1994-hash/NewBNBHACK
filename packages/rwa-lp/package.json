{
  "name": "@yieldvest/rwa-lp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. --project @yieldvest/rwa-lp",
    "build:contracts": "forge build",
    "test:contracts": "forge test",
    "vectors": "tsx src/gen-vectors.ts",
    "abi": "forge build && tsx src/gen-abi.ts"
  },
  "dependencies": {
    "@yieldvest/core": "workspace:*",
    "viem": "2.56.8"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@uniswap/v4-core": "1.0.2",
    "vitest": "5.0.1"
  }
}
